{
  "name": "dsh-agentdeck",
  "version": "0.2.12",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "description": "Ready-to-use scene agents for DeepSeek Harness with native delegation, explicit model settings and extensible skills.",
  "keywords": ["deepseek-harness", "deepseek-harness-plugin", "dsh", "dsh-plugin", "agents", "subagents", "agent-skills", "model-selection", "typescript"],
  "repository": { "type": "git", "url": "https://github.com/oh-dsh-plugins/dsh-agentdeck.git" },
  "homepage": "https://github.com/oh-dsh-plugins/dsh-agentdeck",
  "bugs": { "url": "https://github.com/oh-dsh-plugins/dsh-agentdeck/issues" },
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24.9.0", "dsh": "0.2.2-rc.3" },
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./role": { "types": "./lib/role.d.ts", "default": "./lib/role.js" },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["lib", "assets", "locale", "docs/core-contract.md", "docs/ui-contract.md", "docs/validation.md", "docs/releasing.md", "icon.svg", "cordis.patch.yml", "README.md", "README.zh-CN.md", "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md", "THIRD_PARTY_NOTICES.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "dev:link-host": "node scripts/link-host.mjs"
  },
  "dependencies": { "yaml": "^2.8.1", "zod": "^4.1.0" },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^5.9.3" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-subagent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-subagent": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-scope": { "optional": true },
    "@deepseek-ai/dsh-tool-subagent": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-agent-preset-registry": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-storage-domain": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true }
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-connection"]
    }
  }
}
